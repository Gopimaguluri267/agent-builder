<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Product Requirements Document — {{AGENT_NAME}}</title>
<style>
{{INLINE_STYLES}}
</style>
</head>
<body>
<div class="abd-page">

  <!-- Document-control block — DOC-STD-004 in core/documentation-standards.md -->
  <div class="abd-control-block">
    <table>
      <tr>
        <td class="abd-label">Document</td><td>Product Requirements Document (PRD) — v{{VERSION}}</td>
        <td class="abd-label">Status</td><td><span class="abd-status-badge abd-status-{{STATUS}}">{{STATUS_LABEL}}</span></td>
      </tr>
      <tr>
        <td class="abd-label">Project</td><td>{{PROJECT_ID}} (run {{RUN_ID}})</td>
        <td class="abd-label">Prepared by</td><td>{{PREPARED_BY}}</td>
      </tr>
      <tr>
        <td class="abd-label">Vertical / Usecase</td><td>{{VERTICAL_NAME}} / {{USECASE_NAME}}</td>
        <td class="abd-label">Date Prepared</td><td>{{DATE_PREPARED}}</td>
      </tr>
      <tr>
        <td class="abd-label">Regulatory References</td>
        <td colspan="3" class="abd-reg-refs">{{REGULATORY_REFERENCES_HTML}}</td>
      </tr>
    </table>
  </div>

  <h1 class="abd-title">{{AGENT_NAME}}</h1>
  <p class="abd-subtitle">Product Requirements Document</p>

  <h2 class="abd-section">Problem Statement</h2>
  {{PROBLEM_STATEMENT_HTML}}

  <h2 class="abd-section">Goals</h2>
  {{GOALS_HTML}}

  <h2 class="abd-section">Success Metrics</h2>
  {{SUCCESS_METRICS_HTML}}

  <h2 class="abd-section">User Personas</h2>
  {{USER_PERSONAS_HTML}}

  <h2 class="abd-section">Target Users</h2>
  {{TARGET_USERS_HTML}}

  <h2 class="abd-section">Feature Requirements</h2>
  <!-- Each feature row should cite the usecase-rules.md ID(s) it implements via <span class="abd-ref">CARD-UC-R###</span> -->
  {{FEATURE_REQUIREMENTS_HTML}}

  <h2 class="abd-section">Out-of-Scope</h2>
  {{OUT_OF_SCOPE_HTML}}

  <h2 class="abd-section">Dependencies</h2>
  {{DEPENDENCIES_HTML}}

  <h2 class="abd-section">Open Questions</h2>
  <!-- Wrap each unresolved item in <div class="abd-open-question">...</div> — never omit this section even if empty; state "None outstanding" explicitly if so. -->
  {{OPEN_QUESTIONS_HTML}}

  <!-- Sign-Off section — DOC-STD-004, multi-approver -->
  <div class="abd-signoff {{SIGNOFF_STATE_CLASS}}">
    <h2 class="abd-section">Sign-Off</h2>
    <p class="abd-signoff-statement">{{AFFIRMATION_STATEMENT}}</p>
    <table class="abd-table abd-signoff-table">
      <tr><th>Required Approver Role</th><th>Approver Name</th><th>Signed At</th><th>Status</th></tr>
      {{SIGNOFF_ROWS_HTML}}
    </table>
    <p class="abd-evidence-hash-label">Evidence hash (shared across all approvers, computed once from this document's pending-signoff content before any signature): <span class="abd-evidence-hash">{{EVIDENCE_HASH}}</span></p>
  </div>

</div>
</body>
</html>
